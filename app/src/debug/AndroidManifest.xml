<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    仅 debug 构建包含的测试辅助无障碍服务：给本机的 adb 自动化脚本提供
    「读屏 + 点击 + 设置文本 + 滚动」能力，release 变体不会打包。
  -->
  <application>
    <service
      android:name="me.rerere.rikkahub.debug.WearAutomationService"
      android:exported="true"
      android:label="Wear automation (debug only)"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>

      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/accessibility_wear_automation" />
    </service>
  </application>

</manifest>
